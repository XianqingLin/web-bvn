      "rawScript": "if(!$fighter_ctrler) return;\n\ndefineAction(\"tk\",{power:20,hitType:1,hitx:2,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"tk2\",{power:60,hitType:3,hitx:0,hity:10,hurtTime:500,hurtType:1,isBreakDef:false});\ndefineAction(\"tz\",{power:100,hitType:3,hitx:10,hity:10,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"k1\",{power:20,hitType:1,hitx:2,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"k2\",{power:20,hitType:1,hitx:3,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"k3\",{power:60,hitType:6,hitx:3,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"k4\",{power:60,hitType:3,hitx:3,hity:-5,hurtTime:500,hurtType:0,isBreakDef:false});\n\ndefineAction(\"kj1\",{power:30,hitType:1,hitx:1,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"kj11\",{power:40,hitType:6,hitx:-3,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"kj2\",{power:120,hitType:6,hitx:0,hity:-6,hurtTime:500,hurtType:0,isBreakDef:false});\n\ndefineAction(\"zh1\",{power:140,hitType:6,hitx:10,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"zh2\",{power:30,hitType:4,hitx:0,hity:0,hurtTime:800,hurtType:0,isBreakDef:true});\ndefineAction(\"zh21\",{power:30,hitType:4,hitx:8,hity:0,hurtTime:800,hurtType:0,isBreakDef:false});\ndefineAction(\"zh3\",{power:100,hitType:3,hitx:7,hity:-5,hurtTime:500,hurtType:0,isBreakDef:false});\n\ndefineAction(\"bs\",{power:300,hitType:6,hitx:15,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"sbs\",{power:250,hitType:5,hitx:5,hity:-15,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"cbs\",{power:300,hitType:5,hitx:20,hity:0,hurtTime:0,hurtType:1,isBreakDef:true});\ndefineAction(\"cbs1\",{power:80,hitType:6,hitx:5,hity:3,hurtTime:800,hurtType:0,isBreakDef:false});\ndefineAction(\"cbs2\",{power:40,hitType:1,hitx:5,hity:0,hurtTime:800,hurtType:0,isBreakDef:false});\ndefineAction(\"cbs3\",{power:60,hitType:6,hitx:3,hity:0,hurtTime:800,hurtType:0,isBreakDef:false});\ndefineAction(\"cbs4\",{power:10,hitType:1,hitx:0,hity:-1,hurtTime:800,hurtType:0,isBreakDef:true});\ndefineAction(\"cbs41\",{power:10,hitType:1,hitx:0,hity:-5,hurtTime:800,hurtType:0,isBreakDef:true});\ndefineAction(\"cbs5\",{power:70,hitType:6,hitx:6,hity:0,hurtTime:800,hurtType:0,isBreakDef:false});\n\ndefineAction(\"sh1\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh12\",{power:50,hitType:3,hitx:5,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"sh2\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh22\",{power:150,hitType:0,hitx:-10,hity:-10,hurtTime:0,hurtType:1,isBreakDef:false});\n\n//定义必杀特写\n$fighter_ctrler.defineBishaFace(\"Orochimaru_1\",bsface1);\n$fighter_ctrler.defineBishaFace(\"Orochimaru_2\",bsface2);\n\n//定义声音\n$fighter_ctrler.defineHurtSound(snd_hurt1,snd_hurt2); //被打\n$fighter_ctrler.defineHurtFlySound(snd_hurt3); //击飞\n$fighter_ctrler.defineDieSound(snd_die); //死亡\n\n\n//定义速度\n$fighter_ctrler.speed = 10;\n//定义跳跃力\n$fighter_ctrler.jumpPower = 15;\n//定义体格(数字越大越重)\n$fighter_ctrler.heavy = 3;\n//定义防御类型(0=剑，1=手)\n$fighter_ctrler.defenseType = 1;\n\n//调用初始化方法\n$fighter_ctrler.initMc(mc);",
