      "rawScripts": [
        {
          "frame": 0,
          "raw": "var $attacker_ctrler:*;\n\nfunction setAttackerCtrler(attackerCtrler:*):void{\n\t$attacker_ctrler = attackerCtrler;\n}\n\n//移动\n$attacker_ctrler.move(15,-6);\n$attacker_ctrler.damping(0,0.4);\n\n$attacker_ctrler.setTouchFloor(\"hit\");\n$attacker_ctrler.setHitTarget(\"zh20atm\",\"hit\");"
        },
        {
          "frame": 15,
          "raw": "$attacker_ctrler.gotoAndPlay(\"loop\");"
        },
        {
          "frame": 16,
          "raw": "$attacker_ctrler.stopMove();\n$attacker_ctrler.effect.shine(0x00FF00);"
        },
        {
          "frame": 27,
          "raw": "$attacker_ctrler.endAct();"
        }
      ]
    },
