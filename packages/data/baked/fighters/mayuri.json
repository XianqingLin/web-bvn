          "frame": 1,
          "raw": "//移动\n$attacker_ctrler.move(10,0);"
        },
        {
          "frame": 39,
          "raw": "$attacker_ctrler.damping(2,0);"
        },
        {
          "frame": 41,
          "raw": "$attacker_ctrler.effect.shine();"
        },
        {
          "frame": 47,
          "raw": "//动作结束，用于AI判断\n$attacker_ctrler.endAct();"
