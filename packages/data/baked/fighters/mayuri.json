          "raw": "//如果比较复杂，需要在MC内部加入代码，实现接口\n\nvar $attacker_ctrler:*;\nfunction setAttackerCtrler(attackerCtrler:*):void{\n\t$attacker_ctrler = attackerCtrler;\n}\n"
        },
