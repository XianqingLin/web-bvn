      "rawScript": "if(!$fighter_ctrler) return;\n\ndefineAction(\"tk\",{power:30,hitType:2,hitx:6,hity:8,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"tz\",{power:50,hitType:1,hitx:3,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"tz1\",{power:50,hitType:6,hitx:5,hity:5,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"k1\",{power:30,hitType:2,hitx:3,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"k2\",{power:50,hitType:2,hitx:5,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"k3\",{power:80,hitType:3,hitx:7,hity:-8,hurtTime:600,hurtType:0,isBreakDef:false});\n\ndefineAction(\"kj1\",{power:120,hitType:3,hitx:10,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"kj2\",{power:100,hitType:5,hitx:10,hity:-10,hurtTime:500,hurtType:0,isBreakDef:true});\n\ndefineAction(\"zh1\",{power:30,hitType:1,hitx:4,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"zh2\",{power:120,hitType:9,hitx:10,hity:-5,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"zh3\",{power:40,hitType:1,hitx:4,hity:-4,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"zh31\",{power:40,hitType:6,hitx:6,hity:-6,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"bs\",{power:300,hitType:5,hitx:20,hity:-5,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"sbs\",{power:250,hitType:5,hitx:15,hity:-15,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"cbs1\",{power:21,hitType:1,hitx:2,hity:-0.5,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"cbs\",{power:25,hitType:1,hitx:2,hity:-0.5,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"sh1\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh12\",{power:50,hitType:3,hitx:5,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"sh2\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh22\",{power:150,hitType:3,hitx:10,hity:-10,hurtTime:0,hurtType:1,isBreakDef:false});\n\n//定义必杀特写\n$fighter_ctrler.defineBishaFace(\"Temari_1\",bsface1);\n\n//定义声音\n$fighter_ctrler.defineHurtSound(null); //被打\n$fighter_ctrler.defineHurtFlySound(snd_hurt1); //击飞\n$fighter_ctrler.defineDieSound(snd_hurt1); //死亡\n\n//定义速度\n$fighter_ctrler.speed = 9;\n//定义跳跃力\n$fighter_ctrler.jumpPower = 15;\n//定义体格(数字越大越重)\n$fighter_ctrler.heavy = 2;\n//定义防御类型(0=剑，1=手)\n$fighter_ctrler.defenseType = 1;\n\n//调用初始化方法\n$fighter_ctrler.initMc(mc);",
