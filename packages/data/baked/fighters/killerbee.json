      "rawScript": "if(!$fighter_ctrler) return;\n\ndefineAction(\"tk\",{power:40,hitType:3,hitx:4,hity:10,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"tz1\",{power:30,hitType:1,hitx:3,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"tz\",{power:30,hitType:6,hitx:8,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"k1\",{power:20,hitType:2,hitx:3,hity:0,hurtTime:200,hurtType:0,isBreakDef:false});\ndefineAction(\"k2\",{power:30,hitType:2,hitx:3,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"k3\",{power:40,hitType:1,hitx:4,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"k4\",{power:80,hitType:6,hitx:1,hity:-6,hurtTime:600,hurtType:1,isBreakDef:false});\n\ndefineAction(\"kj1\",{power:30,hitType:1,hitx:5,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"kj21\",{power:60,hitType:1,hitx:3,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"kj22\",{power:60,hitType:1,hitx:8,hity:-8,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"kj2\",{power:80,hitType:6,hitx:15,hity:-7,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"zh1\",{power:35,hitType:4,hitx:7,hity:0,hurtTime:700,hurtType:0,isBreakDef:false});\ndefineAction(\"zh12\",{power:35,hitType:4,hitx:5,hity:0,hurtTime:700,hurtType:0,isBreakDef:false});\ndefineAction(\"zh13\",{power:35,hitType:4,hitx:3,hity:0,hurtTime:700,hurtType:0,isBreakDef:false});\ndefineAction(\"zh2\",{power:160,hitType:9,hitx:10,hity:6,hurtTime:0,hurtType:1,isBreakDef:true});\ndefineAction(\"zh3\",{power:140,hitType:6,hitx:6,hity:-6,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"bs1\",{power:80,hitType:3,hitx:5,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"bs2\",{power:30,hitType:2,hitx:3,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"bs3\",{power:80,hitType:3,hitx:4,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\n\ndefineAction(\"bs\",{power:80,hitType:3,hitx:3,hity:10,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"sbs\",{power:280,hitType:5,hitx:10,hity:-10,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"cbs1\",{power:35,hitType:4,hitx:5,hity:-0.2,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"cbs\",{power:100,hitType:5,hitx:10,hity:0,hurtTime:0,hurtType:1,isBreakDef:true});\n\ndefineAction(\"sh1\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh12\",{power:50,hitType:3,hitx:5,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"sh2\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh22\",{power:150,hitType:6,hitx:20,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\n\n//定义必杀特写\n$fighter_ctrler.defineBishaFace(\"Killerbee_1\",bsface1);\n$fighter_ctrler.defineBishaFace(\"Killerbee_2\",bsface2);\n\n//定义声音\n$fighter_ctrler.defineHurtSound(null); //被打\n$fighter_ctrler.defineHurtFlySound(snd_hurt1); //击飞\n$fighter_ctrler.defineDieSound(snd_hurt1); //死亡\n\n//定义速度\n$fighter_ctrler.speed = 11;\n//定义跳跃力\n$fighter_ctrler.jumpPower = 16;\n//定义体格(数字越大越重)\n$fighter_ctrler.heavy = 5;\n//定义防御类型(0=剑，1=手)\n$fighter_ctrler.defenseType = 1;\n\n//调用初始化方法\n$fighter_ctrler.initMc(mc);",
