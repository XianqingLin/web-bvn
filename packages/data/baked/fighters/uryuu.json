      "rawScripts": [
        {
          "frame": 0,
          "raw": "//发射[参数：MC名称，param]\n/*\nparams 参数 {\n\tx:Number(速度X)|{moveToTarget:Boolean(是否移动到目标),followTarget:Boolean(是否跟随目标),offset:Number(距离目标偏移量)} , \n\ty:Number(速度Y)|{moveToTarget:Boolean(是否移动到目标),followTarget:Boolean(是否跟随目标),offset:Number(距离目标偏移量)} , \n\tapplyG:Boolean(是否受重力影响) ,\n//如果比较复杂，需要在MC内部加入代码，实现接口\n*/\nvar $attacker_ctrler:*;\nfunction setAttackerCtrler(attackerCtrler:*):void{\n\t$attacker_ctrler = attackerCtrler;\n}\n"
        },
        {
          "frame": 1,
          "raw": "$attacker_ctrler.move(0,30);"
        },
        {
          "frame": 2,
          "raw": "$attacker_ctrler.setTouchFloor(\"floor\");"
        },
        {
          "frame": 5,
          "raw": "$attacker_ctrler.stop();"
        },
        {
          "frame": 6,
          "raw": "$attacker_ctrler.effect.shake(0,3);"
        },
        {
          "frame": 12,
          "raw": "$attacker_ctrler.endAct();"
        }
