itType:3,hitx:5,hity:0,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"sh2\",{power:0,hitType:11,hitx:0,hity:0,hurtTime:1000,hurtType:0,isBreakDef:true});\ndefineAction(\"sh22\",{power:50,hitType:2,hitx:-3,hity:-6,hurtTime:1000,hurtType:0,isBreakDef:false});\ndefineAction(\"sh23\",{power:100,hitType:5,hitx:0,hity:-15,hurtTime:0,hurtType:1,isBreakDef:false});\n\n//定义必杀特写\n$fighter_ctrler.defineBishaFace(\"Uryuu_1\",bsface1);\n$fighter_ctrler.defineBishaFace(\"Uryuu_2\",bsface2);\n$fighter_ctrler.defineBishaFace(\"Uryuu_3\",bsface3);\n\n//定义声音\n$fighter_ctrler.defineHurtSound(snd_hurt1); //被打\n$fighter_ctrler.defineHurtFlySound(snd_hurt2); //击飞\n$fighter_ctrler.defineDieSound(snd_die); //死亡\n\n//定义速度\n$fighter_ctrler.speed = 10;\n//定义跳跃力\n$fighter_ctrler.jumpPower = 15;\n//定义体格(数字越大越重)\n$fighter_ctrler.heavy = 2;\n//定义防御类型(0=剑，1=手)\n$fighter_ctrler.defenseType = 1;\n\n$fighter_ctrler.energy = 150;\n\n//调用初始化方法\n$fighter_ctrler.initMc(mc);\n",
