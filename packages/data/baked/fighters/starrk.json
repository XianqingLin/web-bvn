      "rawScript": "if(!$fighter_ctrler) return;\n\ndefineAction(\"tz\",{power:100,hitType:6,hitx:5,hity:6,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"tk\",{power:40,hitType:1,hitx:4,hity:6,hurtTime:500,hurtType:0,isBreakDef:false});\n\ndefineAction(\"k1\",{power:30,hitType:1,hitx:4,hity:0,hurtTime:300,hurtType:0,isBreakDef:false});\ndefineAction(\"k2\",{power:40,hitType:1,hitx:5,hity:0,hurtTime:450,hurtType:0,isBreakDef:false});\ndefineAction(\"k3\",{power:50,hitType:6,hitx:3,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"k4\",{power:60,hitType:6,hitx:6,hity:-8,hurtTime:550,hurtType:0,isBreakDef:false});\n\ndefineAction(\"kj1\",{power:100,hitType:6,hitx:4,hity:0,hurtTime:400,hurtType:0,isBreakDef:false});\ndefineAction(\"kj12\",{power:50,hitType:1,hitx:-2,hity:-3,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"kj21\",{power:60,hitType:6,hitx:6,hity:-10,hurtTime:600,hurtType:0,isBreakDef:false});\ndefineAction(\"kj2\",{power:60,hitType:6,hitx:10,hity:15,hurtTime:600,hurtType:1,isBreakDef:false});\n\ndefineAction(\"zh1\",{power:100,hitType:5,hitx:10,hity:0,hurtTime:0,hurtType:1,isBreakDef:true});\ndefineAction(\"zh2\",{power:30,hitType:1,hitx:5,hity:0,hurtTime:600,hurtType:0,isBreakDef:false});\ndefineAction(\"zh22\",{power:70,hitType:6,hitx:3,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"zh3\",{power:120,hitType:5,hitx:9,hity:-9,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"zh31\",{power:120,hitType:5,hitx:9,hity:-9,hurtTime:0,hurtType:1,isBreakDef:false});\n\ndefineAction(\"bs1\",{power:40,hitType:4,hitx:2,hity:0,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"bs\",{power:60,hitType:5,hitx:20,hity:0,hurtTime:0,hurtType:1,isBreakDef:false});\ndefineAction(\"sbs1\",{power:100,hitType:6,hitx:10,hity:-15,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"sbs2\",{power:100,hitType:6,hitx:10,hity:-10,hurtTime:500,hurtType:0,isBreakDef:false});\ndefineAction(\"sbs\",{power:15