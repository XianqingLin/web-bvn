{
  "name": "bvn-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "replay": "node tools/replay/replay.mjs",
    "batch:validate": "node tools/batch-validate/batch-validate.mjs --expect tools/batch-validate/baseline.json",
    "export:ichigo": "node tools/exporter/dist/main.js fighter OpenBleachVsNaruto/swf_source/f_fighter/ichigo --id ichigo --fighter-xml OpenBleachVsNaruto/swf_output/assets/config/fighter.xml --out packages/data/baked/fighters/ichigo.json",
    "export:all": "node tools/exporter/dist/main.js batch --xfl-root OpenBleachVsNaruto/swf_source --out-dir packages/data/baked --fighter-xml OpenBleachVsNaruto/swf_output/assets/config/fighter.xml",
    "dev:net": "node tools/dev-net.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "node-unrar-js": "^2.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.4.2"
}
