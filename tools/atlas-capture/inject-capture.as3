// =====================================================================
// BVN capture 桥 —— 注入 FighterTester 文档类的方法块（注入代码，非原版）
//
// 目的：把角色/辅助/地图的视觉内容栅格化导出，供 web 渲染层做图集：
//   1. 角色/辅助：逐（root 形态帧 × 内层动画帧）gotoAndStop，把 root
//      渲染进 BitmapData，PNG 落盘；按像素哈希去重（大量帧同姿势）。
//      每帧记录内容相对 root 的 bounds（root 局部原点 = 引擎角色坐标，
//      翻转绕原点 —— BaseGameSprite: _mainMc.x=_x; scaleX=direct*scale）。
//   2. 地图：移除 line_*/p1/p2（同 MapMain.initlize），逐子图层渲染
//      PNG + 记录子图层相对地图 root 的偏移。
//
// 输出：File.documentsDirectory/bvn-atlas/
//   png/<kind>_<id>/<n>.png          唯一帧位图（n = 序号）
//   atlas_char_<kind>_<id>.json      帧→png 映射 + 每帧 root 局部 bounds
//   atlas_map_<id>.json              地图子图层 png + 偏移
// 全部完成后 exit(0)。
//
// PNG 编码：手写实现（目标 SWF ver17 = FP11.0，无 BitmapData.encode）。
// 类型 6（RGBA）+ filter 0；IDAT 用 ByteArray.compress()（zlib）。
// =====================================================================

      // ==================== BVN capture 桥（注入代码，非原版）====================
      private var _capItems:Array;
      private var _capIdx:int = 0;
      private var _capLog:Array;

      private function capBootLog(param1:String) : void
      {
         try
         {
            var f:File = File.documentsDirectory.resolvePath("bvn-atlas/boot.log");
            if(!f.parent.exists)
            {
               f.parent.createDirectory();
            }
            var s:FileStream = new FileStream();
            s.open(f,"append");
            s.writeUTFBytes("[" + new Date().time + "] " + param1 + "\n");
            s.close();
         }
         catch(e:Error)
         {
         }
      }

      private function startBvnCapture() : void
      {
         // 全局静音：采集过程逐帧触发大量音效（帧声音/脚本播音），太吵
         try
         {
            SoundMixer.soundTransform = new SoundTransform(0);
         }
         catch(se:Error)
         {
         }
         capBootLog("startBvnCapture enter");
         try
         {
            this.loaderInfo.uncaughtErrorEvents.addEventListener("uncaughtError",function(param1:UncaughtErrorEvent) : void
            {
               capBootLog("UNCAUGHT: " + param1.message);
            });
         }
         catch(ue:Error)
         {
            capBootLog("uncaught hook err: " + ue.message);
         }
         _capLog = [];
         _capItems = [];
         // 可选 kind 过滤：Documents/bvn-atlas/capture-only.txt 存在时只采集该 kind
         //（如 "assister"），用于桥修复后的局部重采，避免全量重跑 166k 角色帧。
         var onlyKind:String = null;
         var onlyId:String = null;
         try
         {
            var fo:File = File.documentsDirectory.resolvePath("bvn-atlas/capture-only.txt");
            if(fo.exists)
            {
               var sf0:FileStream = new FileStream();
               sf0.open(fo,"read");
               onlyKind = sf0.readUTFBytes(sf0.bytesAvailable).replace(/[\r\n\s]/g,"");
               sf0.close();
               // 过滤格式：kind | kind:id | diag:kind:id | probe:kind:id
               // diag: = 子元件播放头追踪；probe: = 单独质询子元件各帧渲染内容
               if(onlyKind.indexOf("diag:") == 0)
               {
                  _capDiag = true;
                  onlyKind = onlyKind.substring(5);
               }
               if(onlyKind.indexOf("probe:") == 0)
               {
                  _capProbe = true;
                  _capDiag = true; // probe 运行同时开逐帧追踪
                  onlyKind = onlyKind.substring(6);
               }
               var ci:int = onlyKind.indexOf(":");
               if(ci != -1)
               {
                  onlyId = onlyKind.substring(ci + 1);
                  onlyKind = onlyKind.substring(0,ci);
               }
               capBootLog("filter kind=" + onlyKind + " id=" + onlyId + " diag=" + _capDiag);
            }
         }
         catch(fe:Error)
         {
         }
         var fs:* = FighterModel.I.getFighters();
         for each(var fv:* in fs)
         {
            if(onlyKind == null || onlyKind == "fighter")
            {
               if(onlyId == null || fv.id == onlyId)
               {
                  _capItems.push({"kind":"fighter","id":fv.id,"url":fv.fileUrl});
               }
            }
         }
         var asl:* = AssisterModel.I.getAssisters();
         for each(var av:* in asl)
         {
            if(onlyKind == null || onlyKind == "assister")
            {
               if(onlyId == null || av.id == onlyId)
               {
                  _capItems.push({"kind":"assister","id":av.id,"url":av.fileUrl});
               }
            }
         }
         var mpl:* = MapModel.I.getAllMaps();
         for each(var mv:* in mpl)
         {
            if(onlyKind == null || onlyKind == "map")
            {
               _capItems.push({"kind":"map","id":mv.id,"url":mv.fileUrl});
            }
         }         // fire 采集（切片 13-A3）：fire/addAttacker 命名子元件逐帧栅格化。
         // 名单来自 fire-names.json（collect-fire-names.mjs 从 baked JSON 提取），
         // 元件缺失/非 MC 的记 skip 不算失败。attackers（B 步）同机制顺带覆盖。
         if(onlyKind == null || onlyKind == "fire")
         {
            var fnj:Object = null;
            try
            {
               var ff:File = File.documentsDirectory.resolvePath("bvn-atlas/fire-names.json");
               if(ff.exists)
               {
                  var sfn:FileStream = new FileStream();
                  sfn.open(ff,"read");
                  fnj = JSON.parse(sfn.readUTFBytes(sfn.bytesAvailable));
                  sfn.close();
               }
            }
            catch(fe2:Error)
            {
            }
            if(fnj != null)
            {
               for each(var ffv:* in fs)
               {
                  if(fnj.fighter != null && fnj.fighter[ffv.id] != null)
                  {
                     if(onlyId == null || ffv.id == onlyId)
                     {
                        _capItems.push({"kind":"fire","ownerKind":"fighter","id":ffv.id,"url":ffv.fileUrl,"names":fnj.fighter[ffv.id]});
                     }
                  }
               }
               for each(var fav:* in asl)
               {
                  if(fnj.assister != null && fnj.assister[fav.id] != null)
                  {
                     if(onlyId == null || fav.id == onlyId)
                     {
                        _capItems.push({"kind":"fire","ownerKind":"assister","id":fav.id,"url":fav.fileUrl,"names":fnj.assister[fav.id]});
                     }
                  }
               }
            }
            else
            {
               capBootLog("fire-names.json 缺失，跳过 fire 采集");
            }
         }
         capBootLog("items built: " + _capItems.length);
         capLog("capture items: " + _capItems.length);
         _capIdx = 0;
         setTimeout(capNext,100);
      }

      private function capLog(param1:String) : void
      {
         _capLog.push(param1);
         trace("[bvn-atlas] " + param1);
      }

      private function capNext() : void
      {
         if(_capIdx >= _capItems.length)
         {
            capFinish();
            return;
         }
         var it:Object = _capItems[_capIdx];
         capBootLog("next[" + _capIdx + "] " + it.kind + ":" + it.id);
         try
         {
            capOne(it);
         }
         catch(de:Error)
         {
            capBootLog("CAPONE ERR: " + de.errorID + " " + de.message + " :: " + de.getStackTrace());
         }
         _capIdx++;
      }

      private function capOne(item:Object) : void
      {
         var bytes:ByteArray = capReadSwf(item.url);
         if(bytes == null)
         {
            item.error = "无法读取 SWF: " + item.url;
            capLog("FAIL read " + item.kind + ":" + item.id);
            capWriteManifest();
            setTimeout(capNext,30);
            return;
         }
         var loader:Loader = new Loader();
         var ctx:LoaderContext = new LoaderContext(false,new ApplicationDomain());
         ctx.allowCodeImport = true;
         var onOk:Function = function(param1:Event) : void
         {
            loader.contentLoaderInfo.removeEventListener("complete",onOk);
            loader.contentLoaderInfo.removeEventListener("ioError",onFail);
            try
            {
               if(item.kind == "map")
               {
                  capMap(item,loader.content);
               }
               else if(item.kind == "fire")
               {
                  capFire(item,loader.content as MovieClip);
               }
               else
               {
                  capChar(item,loader.content as MovieClip);
               }
               item.ok = true;
            }
            catch(e:Error)
            {
               item.error = e.message;
               capLog("FAIL capture " + item.kind + ":" + item.id + " :: " + e.message);
            }
            try
            {
               loader.unloadAndStop(true);
            }
            catch(e2:Error)
            {
            }
            capWriteManifest();
            setTimeout(capNext,30);
         };
         var onFail:Function = function(param1:Event) : void
         {
            loader.contentLoaderInfo.removeEventListener("complete",onOk);
            loader.contentLoaderInfo.removeEventListener("ioError",onFail);
            item.error = "loadBytes 失败";
            capLog("FAIL load " + item.kind + ":" + item.id);
            capWriteManifest();
            setTimeout(capNext,30);
         };
         loader.contentLoaderInfo.addEventListener("complete",onOk);
         loader.contentLoaderInfo.addEventListener("ioError",onFail);
         loader.loadBytes(bytes,ctx);
      }

      private function capReadSwf(param1:String) : ByteArray
      {
         var out:ByteArray = null;
         try
         {
            var f:File = File.applicationDirectory.resolvePath(param1);
            if(!f.exists)
            {
               return null;
            }
            var s:FileStream = new FileStream();
            s.open(f,"read");
            out = new ByteArray();
            s.readBytes(out);
            s.close();
            out.position = 0;
         }
         catch(e:Error)
         {
            out = null;
         }
         return out;
      }

      // ---------- 角色 / 辅助 capture ----------

      // no-op 控制器注入（同 dump 桥：帧脚本的 ctrler 调用全部吸收）。
      // capChar 与 capFire 共用——fire 元件多为时间轴摆放，但部分（如 byakuya
      // 辅助 atmmc）在帧脚本里 new + addChild 运行时挂载，脚本不走 ctrler
      // 挂载就不会发生，capFire 扫描前必须先注入。
      private function capInitFakes(root:MovieClip, id:String) : Object
      {
         var innerRef:* = null;
         var fakeCtrler:Object = {
            "defineAction":function(param1:String, param2:Object) : void {},
            "initMc":function(param1:*) : void
            {
               innerRef = param1;
            },
            "defineBishaFace":function(param1:String, param2:*) : void {},
            "getSelf":function(... rest) : * { return null; },
            "justHit":function(... rest) : Boolean { return false; },
            "targetInRange":function(... rest) : Boolean { return false; },
            "moveToTarget":function(... rest) : void {},
            "moveOnce":function(... rest) : void {},
            "setCross":function(... rest) : void {},
            "setDirectToTarget":function(... rest) : void {},
            "setDirectReverse":function(... rest) : void {},
            "doWanKai":function(... rest) : void {},
            "addHpLosePercent":function(... rest) : void {},
            "defineHurtSound":function(... rest) : void {},
            "defineHurtFlySound":function(... rest) : void {},
            "defineDieSound":function(... rest) : void {},
            "defenseType":0,
            "heavy":0,
            "jumpPower":0,
            "speed":0
         };
         // 辅助侧 no-op（AssisterCtrler API）：byakuya 辅助第 52 帧脚本在
         // attach atmmc 前调 addCustomFunc——缺了脚本抛错、挂载不发生
         var assistNoops:Array = ["addCustomFunc","removeCustomFunc","addAttacker","setHitTarget","removeAttacker","setTouchSide","finish"];
         for each(var nm3:String in assistNoops)
         {
            fakeCtrler[nm3] = function(... rest) : * { return null; };
         }
         fakeCtrler["getAttacker"] = function(... rest) : * { return null; };
         fakeCtrler["getOwner"] = function(... rest) : * { return null; };
         fakeCtrler["getTarget"] = function(... rest) : * { return null; };
         var mcNoops:Array = ["addQi","dash","dashStop","endAct","fire","gotoAndPlay","idle","justHitToPlay","loop","move","movePercent","setAirMove","setAttack","setAttackAIR","setBisha","setBishaAIR","setBishaSUPER","setBishaUP","setDash","setHitTarget","setHurtAction","setJump","setSkill","setSkillAIR","setSteelBody","setTouchFloor","setZhao","stop","stopMove","setBishaEnd","playVoice"];
         var fakeMc:Object = {};
         for each(var nm1:String in mcNoops)
         {
            fakeMc[nm1] = function(... rest) : * { return null; };
         }
         var effNoops:Array = ["bisha","dash","endBisha","endShadow","endShake","endWanKai","jump","playSoundHit","playSoundHit2","shadow","shake","shine","slowDown","startShake","startWanKai","walk"];
         var fakeEff:Object = {};
         for each(var nm2:String in effNoops)
         {
            fakeEff[nm2] = function(... rest) : * { return null; };
         }
         fakeCtrler["effect"] = fakeEff;
         var isFighterType:Boolean = false;
         if(root.initFighter != null)
         {
            try
            {
               root.initFighter({
                  "fighter_ctrler":fakeCtrler,
                  "mc_ctrler":fakeMc,
                  "effect_ctrler":fakeEff
               });
               isFighterType = true;
            }
            catch(ie:Error)
            {
               capBootLog("initFighter ERR " + id + ": " + ie.message);
            }
         }
         if(!isFighterType && root.setAssistCtrler != null)
         {
            try
            {
               root.setAssistCtrler(fakeCtrler);
            }
            catch(ae:Error)
            {
               capBootLog("setAssistCtrler ERR " + id + ": " + ae.message);
            }
         }
         return {"isFighterType":isFighterType,"innerRef":innerRef};
      }

      private function capChar(item:Object, root:MovieClip) : void
      {
         if(root == null)
         {
            item.error = "SWF root 不是 MovieClip";
            return;
         }

         var inited:Object = capInitFakes(root,item.id);
         var innerRef:* = inited.innerRef;
         var isFighterType:Boolean = inited.isFighterType;
         if(!isFighterType && root.setAssistCtrler == null && root.initFighter == null)
         {
            item.error = "SWF 无 initFighter/setAssistCtrler 入口";
            capLog("FAIL entry " + item.id);
            return;
         }

         // 唯一帧收集：哈希 → png 序号
         var seen:Object = {};
         var pngCount:int = 0;
         var pngList:Array = [];
         var rootFrames:Array = [];

         if(isFighterType)
         {
            for(var r:int = 1; r <= root.totalFrames; r++)
            {
               innerRef = null;
               try
               {
                  root.gotoAndStop(r);
               }
               catch(e:Error)
               {
                  capBootLog("root goto " + item.id + " r" + r + " ERR: " + e.message);
               }
               var inner:* = innerRef;
               if(inner == null)
               {
                  inner = root.getChildByName("mc");
               }
               _capRootFrame = r;
               var formRec:Object = {"rootFrame":r,"frames":[]};
               if(inner != null && inner is MovieClip && inner.totalFrames > 0)
               {
                  capSweepFrames(item,root,inner,seen,pngList,function():int
                  {
                     pngCount++;
                     return pngCount;
                  },formRec.frames);
               }
               rootFrames.push(formRec);
            }
         }
         else
         {
            // 辅助：root 本身就是动画时间轴，引擎 goFight 后每 tick
            // renderChildren + nextFrame 连续播放——不用标签扫描（2026-11-10 修复）：
            // 26/37 辅助 root 时间轴无帧标签（currentLabels 空 → 标签扫描一格不扫），
            // 11 个首标签靠后（byakuya 首标签在 52 帧 → 出场段 1~51 全漏）。
            capBootLog("assist labels " + item.id + " n=" + root.currentLabels.length + " total=" + root.totalFrames);
            var formRec2:Object = {"rootFrame":1,"frames":[]};
            capSweepAllFrames(item,root,root,seen,pngList,function():int
            {
               pngCount++;
               return pngCount;
            },formRec2.frames);
            rootFrames.push(formRec2);
         }

         var outData:Object = {
            "kind":item.kind,
            "id":item.id,
            "fileUrl":item.url,
            "pngCount":pngList.length,
            "pngs":pngList,
            "rootFrames":rootFrames
         };
         capWriteJson("atlas_char_" + item.kind + "_" + item.id + ".json",outData);
         capLog("captured " + item.kind + ":" + item.id + " pngs=" + pngList.length);
      }

      // 诊断模式（capture-only.txt = diag:kind:id）：追踪子元件播放头行为，
      // 定位 MovieClip 子元件推进失效机制（块 10）。每次推进前后记录：
      // 运行时类、totalFrames、currentFrame、currentFrameLabel、实例身份
      // （REINST = 父时间轴移动导致重实例化）、与上次 currentFrame 的跳变。
      private var _capDiag:Boolean = false;
      private var _capProbe:Boolean = false;
      private var _capDiagSeen:Object;
      private var _capDiagPrev:Object;
      private var _capRootFrame:int = 0;

      // probe：对标签扫描完的 mc，逐个多帧子元件单独质询——直接 gotoAndStop(k)
      // 渲染其自身并哈希。若哈希随 k 变化 = 子元件各帧内容不同（采集管线问题）；
      // 若恒同 = 符号本身静态（烘焙忠实，走段"静止"是原版语义）。
      private function capProbeChildren(mc:MovieClip, labName:String) : void
      {
         for(var i:int = 0; i < mc.numChildren; i++)
         {
            var c1:MovieClip = mc.getChildAt(i) as MovieClip;
            if(c1 == null || c1.totalFrames < 2)
            {
               continue;
            }
            var nm:String = c1.name;
            if(nm != null && (nm == "AImain" || nm == "bdmn" || nm.indexOf("atm") != -1))
            {
               continue;
            }
            capProbeOne(c1,labName + "#i" + i + "_" + nm);
         }
      }

      private function capProbeOne(c1:MovieClip, tag:String) : void
      {
         for(var k:int = 1; k <= c1.totalFrames; k++)
         {
            try
            {
               c1.gotoAndStop(k);
            }
            catch(e:Error)
            {
               capBootLog("probe goto ERR " + e.message);
            }
            var line:String = "PROBE " + tag + " k=" + k + " cf=" + c1.currentFrame + " n=" + c1.numChildren;
            for(var j:int = 0; j < c1.numChildren; j++)
            {
               var ch:DisplayObject = c1.getChildAt(j);
               line = line + (" |" + j + ":" + ch.name + ":" + getQualifiedClassName(ch));
            }
            var b:Rectangle = c1.getBounds(c1);
            var w:int = Math.ceil(b.width) + 2;
            var h:int = Math.ceil(b.height) + 2;
            if(w > 0 && h > 0 && w <= 512 && h <= 512)
            {
               var bmp:BitmapData = new BitmapData(w,h,true,0);
               try
               {
                  bmp.draw(c1,new Matrix(1,0,0,1,-(b.x - 1),-(b.y - 1)));
                  capHashPair(bmp);
                  line = line + (" h=" + _h1 + ":" + _h2 + " dim=" + w + "x" + h);
               }
               catch(e2:Error)
               {
                  line = line + (" draw ERR " + e2.message);
               }
               bmp.dispose();
            }
            capBootLog(line);
         }
      }

      private function capDiagChildren(mc:MovieClip, tag:String, depth:int) : void
      {
         for(var i:int = 0; i < mc.numChildren; i++)
         {
            var c:DisplayObject = mc.getChildAt(i);
            var q:String = getQualifiedClassName(c);
            var m:MovieClip = c as MovieClip;
            var line:String = tag + " d" + depth + " i" + i + " nm=" + c.name + " cls=" + q;
            if(m != null)
            {
               line = line + (" tf=" + m.totalFrames + " cf=" + m.currentFrame + " lbl=" + m.currentFrameLabel);
               if(depth == 1 && _capDiagSeen != null)
               {
                  var key:String = "i" + i + "_" + c.name;
                  if(_capDiagSeen[key] != null && _capDiagSeen[key] != c)
                  {
                     line = line + " REINST";
                  }
                  _capDiagSeen[key] = c;
                  if(_capDiagPrev[key] != null && _capDiagPrev[key] != m.currentFrame)
                  {
                     line = line + (" CFJUMP(" + _capDiagPrev[key] + ")");
                  }
                  _capDiagPrev[key] = m.currentFrame;
               }
            }
            capBootLog(line);
            if(depth < 2 && m != null && m.totalFrames > 1)
            {
               capDiagChildren(m,tag,depth + 1);
            }
         }
      }

      private function capDiagTag(labName:String, f:int, phase:String) : String
      {
         return "DG " + labName + "@" + f + " " + phase;
      }

      // 逐标签镜像 FighterMC.goFrame/renderAnimate 语义采集：
      // 姿势画在子剪辑自身时间轴，引擎每 tick「主时间轴 nextFrame + 子剪辑推进 1 格」
      // （renderChildren），主时间轴关键帧只是放置载体——单纯 gotoAndStop(f) 子剪辑
      // 全停在初始帧，截不到姿势（首次实现即败于此）。
      // 采集序列：gotoAndStop(标签起始) → advanceChildren → 截图(k=0)
      //          → [nextFrame + advanceChildren → 截图(k=1..d-1)]。
      // 输出帧号 = 绝对内层帧（core animFrame 语义）；标签外帧记空（引擎不显示）。
      private function capSweepFrames(item:Object, rootRef:DisplayObject, mc:MovieClip, seen:Object, pngList:Array, nextId:Function, outFrames:Array) : void
      {
         // 只排除判定区标记节点（atm*/bdmn*/AImain*）——未命名 instance* 是姿势美术载体
         var skipRe:RegExp = /^(atm|bdmn|AImain)/;
         for(var f:int = 1; f <= mc.totalFrames; f++)
         {
            outFrames.push({"frame":f,"png":-1});
         }
         var labels:Array = mc.currentLabels;
         for(var li:int = 0; li < labels.length; li++)
         {
            var lab:* = labels[li];
            var s:int = lab.frame;
            var d:int = (li < labels.length - 1 ? labels[li + 1].frame : mc.totalFrames + 1) - s;
            if(d < 1)
            {
               d = 1;
            }
            if(_capDiag)
            {
               _capDiagSeen = {};
               _capDiagPrev = {};
            }
            try
            {
               mc.gotoAndStop(s);
            }
            catch(e:Error)
            {
               capBootLog("label goto " + item.id + " " + lab.name + " ERR: " + e.message);
            }
            if(_capDiag)
            {
               capDiagChildren(mc,capDiagTag(lab.name,s,"PRE"),1);
            }
            capAdvanceChildren(mc,skipRe);
            if(_capDiag)
            {
               capDiagChildren(mc,capDiagTag(lab.name,s,"POST"),1);
            }
            capShotFrame(item,rootRef,mc,s,seen,pngList,nextId,outFrames,skipRe);
            if(_capDiag)
            {
               capBootLog(capDiagTag(lab.name,s,"PNG") + " png=" + outFrames[s - 1].png);
            }
            for(var k:int = 1; k < d; k++)
            {
               try
               {
                  mc.nextFrame();
               }
               catch(e2:Error)
               {
                  capBootLog("label next " + item.id + " " + lab.name + " ERR: " + e2.message);
               }
               if(_capDiag)
               {
                  capDiagChildren(mc,capDiagTag(lab.name,s + k,"PRE"),1);
               }
               capAdvanceChildren(mc,skipRe);
               if(_capDiag)
               {
                  capDiagChildren(mc,capDiagTag(lab.name,s + k,"POST"),1);
               }
               capShotFrame(item,rootRef,mc,s + k,seen,pngList,nextId,outFrames,skipRe);
               if(_capDiag)
               {
                  capBootLog(capDiagTag(lab.name,s + k,"PNG") + " png=" + outFrames[s + k - 1].png);
               }
            }
            if(_capProbe && (lab.name == "走" || lab.name == "站立"))
            {
               capProbeChildren(mc,item.id + ":r" + _capRootFrame + ":" + lab.name);
            }
         }
      }

      // 辅助专用：连续全时间轴扫描，逐帧 gotoAndStop(f) + 推进子剪辑 + 截图。
      // 引擎对辅助按 nextFrame 逐帧驱动（Assister.renderAnimate），显示帧 f 时
      // playhead 就在 f——逐帧定位即引擎语义；gotoAndStop 还对时间轴脚本里
      // 的 gotoAndPlay 跳帧免疫（每次迭代重新定位）。子剪辑推进沿用
      // capAdvanceChildren（镜像 renderChildren，每 tick 一格）。
      private function capSweepAllFrames(item:Object, rootRef:DisplayObject, mc:MovieClip, seen:Object, pngList:Array, nextId:Function, outFrames:Array) : void
      {
         var skipRe:RegExp = /^(atm|bdmn|AImain)/;
         for(var f0:int = 1; f0 <= mc.totalFrames; f0++)
         {
            outFrames.push({"frame":f0,"png":-1});
         }
         for(var f:int = 1; f <= mc.totalFrames; f++)
         {
            try
            {
               mc.gotoAndStop(f);
            }
            catch(e:Error)
            {
               capBootLog("assist goto " + item.id + " f" + f + " ERR: " + e.message);
            }
            capAdvanceChildren(mc,skipRe);
            capShotFrame(item,rootRef,mc,f,seen,pngList,nextId,outFrames,skipRe);
         }
      }

      // 镜像 FighterMC.renderChildren：子 MovieClip 每 tick 推进 1 格（到尾回绕），
      // 名为 AImain/bdmn/atm* 的标记节点与 currentFrameLabel=="stop" 的子剪辑除外
      private function capAdvanceChildren(mc:MovieClip, skipRe:RegExp) : void
      {
         for(var i:int = 0; i < mc.numChildren; i++)
         {
            var c1:MovieClip = mc.getChildAt(i) as MovieClip;
            if(c1 == null)
            {
               continue;
            }
            var nm:String = c1.name;
            if(nm != null && (nm == "AImain" || nm == "bdmn" || nm.indexOf("atm") != -1))
            {
               continue;
            }
            if(c1.totalFrames < 2)
            {
               continue;
            }
            if(c1.currentFrameLabel == "stop")
            {
               continue;
            }
            if(c1.currentFrame == c1.totalFrames)
            {
               c1.gotoAndStop(1);
            }
            else
            {
               c1.nextFrame();
            }
         }
      }

      // 单帧采集：算内容 bounds（相对 rootRef）→ 渲染 → 哈希去重落盘
      private function capShotFrame(item:Object, rootRef:DisplayObject, mc:MovieClip, f:int, seen:Object, pngList:Array, nextId:Function, outFrames:Array, skipRe:RegExp) : void
      {
            // 内容 bounds：rootRef 局部坐标系，排除判定区标记节点
            var rx:Number = 1e9;
            var ry:Number = 1e9;
            var rx2:Number = -1e9;
            var ry2:Number = -1e9;
            var has:Boolean = false;
            for(var i:int = 0; i < mc.numChildren; i++)
            {
               var ch:DisplayObject = mc.getChildAt(i);
               var nm:String = ch.name;
               if(nm == null || skipRe.test(nm))
               {
                  continue;
               }
               var b:Rectangle = ch.getBounds(rootRef);
               if(b.width <= 0 || b.height <= 0)
               {
                  continue;
               }
               if(b.x < rx)
               {
                  rx = b.x;
               }
               if(b.y < ry)
               {
                  ry = b.y;
               }
               if(b.x + b.width > rx2)
               {
                  rx2 = b.x + b.width;
               }
               if(b.y + b.height > ry2)
               {
                  ry2 = b.y + b.height;
               }
               has = true;
            }
            if(!has)
            {
               // 无可见内容：该帧记空（引用 null png）
               outFrames[f - 1] = {"frame":f,"png":-1};
               return;
            }
            var rw:int = Math.ceil(rx2 - rx) + 2;
            var rh:int = Math.ceil(ry2 - ry) + 2;
            if(rw > 1024 || rh > 1024)
            {
               capBootLog("SIZE CAP " + item.id + " f" + f + " " + rw + "x" + rh);
               rw = Math.min(rw,1024);
               rh = Math.min(rh,1024);
            }
            var bmp:BitmapData = new BitmapData(rw,rh,true,0);
            var mtx:Matrix = new Matrix(1,0,0,1,-(rx - 1),-(ry - 1));
            try
            {
               bmp.draw(rootRef,mtx,null,null,new Rectangle(0,0,rw,rh));
            }
            catch(e2:Error)
            {
               capBootLog("draw " + item.id + " f" + f + " ERR: " + e2.message);
               bmp.dispose();
               outFrames[f - 1] = {"frame":f,"png":-1};
               return;
            }
            capHashPair(bmp);
            var key:String = rw + "x" + rh + ":" + _h1 + ":" + _h2;
            var pngId:int = -1;
            if(seen[key] != null)
            {
               pngId = seen[key];
               bmp.dispose();
            }
            else
            {
               pngId = nextId();
               seen[key] = pngId;
               var png:ByteArray = capPngEncode(bmp);
               bmp.dispose();
               capWritePng(item.pngPrefix != null ? item.pngPrefix : item.kind + "_" + item.id,pngId,png);
               pngList.push({"id":pngId,"w":rw,"h":rh});
            }
            outFrames[f - 1] = {
               "frame":f,
               "png":pngId,
               "x":Math.round((rx - 1) * 100) / 100,
               "y":Math.round((ry - 1) * 100) / 100
            };
      }

      // FNV-1a 32bit 单遍取双哈希（写入成员 _h1/_h2）：h1 覆盖 RGBA 全字节，
      // h2 只覆盖 RGB（跳 alpha 字节），双哈希降碰撞。
      private var _h1:uint;
      private var _h2:uint;

      private function capHashPair(bmp:BitmapData) : void
      {
         var px:ByteArray = bmp.getPixels(new Rectangle(0,0,bmp.width,bmp.height));
         px.position = 0;
         var a:uint = 2166136261;
         var b:uint = 2166136261;
         var n:int = px.length;
         // FNV 素数乘法用移位分解（h*16777619 mod 2^32）：
         // AS3 的 * 是浮点乘，超过 2^53 丢精度，不能用
         for(var i:int = 0; i < n; i++)
         {
            a = a ^ px[i];
            a += (a << 1) + (a << 4) + (a << 7) + (a << 8) + (a << 24);
            if((i & 3) != 3)
            {
               b = b ^ px[i];
               b += (b << 1) + (b << 4) + (b << 7) + (b << 8) + (b << 24);
            }
         }
         px.length = 0;
         _h1 = a;
         _h2 = b;
      }

      // ---------- fire / attacker 元件 capture（切片 13-A3） ----------

      // fire(mcName) 取命名子 MovieClip 挂 playerLayer 飞行（FighterMcCtrler：
      // _mc=内层"mc"剪辑的子对象；AssisterCtrler：_assister.mc 的子对象）——
      // 元件不在 root 直下，而是摆在内层时间轴的关键帧上，须全时间轴扫描定位。
      // Bullet.renderAnimate（30Hz）只推进元件自身时间轴；嵌套子剪辑采集时
      // 沿用 capAdvanceChildren（同辅助扫描）。帧标签（loop/remove/hit/
      // hit_over/timeout）与 main 子对象 bounds（Bullet._bulletArea 锚）一并记录。
      private function capFire(item:Object, root:MovieClip) : void
      {
         if(root == null)
         {
            item.error = "SWF root 不是 MovieClip";
            return;
         }
         var names:Array = item.names as Array;
         if(names == null || names.length == 0)
         {
            capLog("fire " + item.id + " 无名单，跳过");
            item.ok = true;
            return;
         }
         // 注入 fake 控制器：帧脚本里的运行时挂载（new + addChild）才能发生
         capInitFakes(root,item.id);
         var wanted:Object = {};
         for(var ni:int = 0; ni < names.length; ni++)
         {
            wanted[String(names[ni])] = true;
         }
         // 阶段一：递归扫描定位元件实例（首个命中即定，同名同库符号时间轴一致）。
         // root 的子对象多为未命名 instanceNNN（内层 MC 不叫 "mc"），fire 元件
         // 摆在内层时间轴关键帧上——逐 root 帧重扫，后代 MovieClip 逐帧推进枚举
         // 直接子对象，深度 3 足够（root > 内层 > 嵌套）。
         var found:Object = {};
         _capFoundCount = 0;
         for(var r:int = 1; r <= root.totalFrames; r++)
         {
            if(_capFoundCount >= names.length)
            {
               break;
            }
            try
            {
               root.gotoAndStop(r);
            }
            catch(re:Error)
            {
               capBootLog("fire locate root " + item.id + " r" + r + " ERR: " + re.message);
            }
            capSweepFind(root,wanted,found,3,item.id,r,names.length);
         }
         // 阶段二：逐元件栅格化自身时间轴 + 记录元数据
         var seen:Object = {};
         var pngCount:int = 0;
         var pngList:Array = [];
         var fires:Object = {};
         var fireSkipRe:RegExp = /^(atm|bdmn|AImain|main)/;
         // png 目录带 ownerKind：fighter/assister 的 id 可能同名（byakuya 双栖）
         item.pngPrefix = "fire_" + item.ownerKind + "_" + item.id;
         for(var nmS:String in wanted)
         {
            var mc:MovieClip = found[nmS] as MovieClip;
            if(mc == null)
            {
               fires[nmS] = {"missing":true};
               capLog("fire " + item.id + " " + nmS + " 时间轴上未找到");
               continue;
            }
            // main 锚：Bullet.setHitVO 的 _bulletArea 来源（无 main 回退元件自身
            // bounds，同原版）；坐标 = 相对元件原点（direct=1 空间）
            var anchor:DisplayObject = mc.getChildByName("main");
            if(anchor == null)
            {
               anchor = mc;
            }
            var ab:Rectangle = anchor.getBounds(mc);
            var rec:Object = {
               "rootX":mc.x,
               "rootY":mc.y,
               "totalFrames":mc.totalFrames,
               "labels":capLabelsOf(mc),
               "main":{"x":ab.x,"y":ab.y,"w":ab.width,"h":ab.height},
               "frames":[]
            };
            for(var f0:int = 1; f0 <= mc.totalFrames; f0++)
            {
               rec.frames.push({"frame":f0,"png":-1});
            }
            if(_capDiag)
            {
               _capDiagSeen = {};
               _capDiagPrev = {};
            }
            for(var f2:int = 1; f2 <= mc.totalFrames; f2++)
            {
               try
               {
                  mc.gotoAndStop(f2);
               }
               catch(e:Error)
               {
                  capBootLog("fire goto " + item.id + " " + nmS + " f" + f2 + " ERR: " + e.message);
               }
               if(_capDiag)
               {
                  capDiagChildren(mc,capDiagTag(nmS + "@fire" + _capRootFrame,f2,"PRE"),1);
               }
               capAdvanceChildren(mc,fireSkipRe);
               if(_capDiag)
               {
                  capDiagChildren(mc,capDiagTag(nmS + "@fire" + _capRootFrame,f2,"POST"),1);
               }
               capShotFrame(item,mc,mc,f2,seen,pngList,function():int
               {
                  pngCount++;
                  return pngCount;
               },rec.frames,fireSkipRe);
            }
            if(_capProbe)
            {
               capProbeChildren(mc,item.id + ":fire:" + nmS);
            }
            fires[nmS] = rec;
         }
         var outData:Object = {
            "kind":"fire",
            "ownerKind":item.ownerKind,
            "id":item.id,
            "fileUrl":item.url,
            "pngCount":pngList.length,
            "pngs":pngList,
            "fires":fires
         };
         capWriteJson("atlas_fire_" + item.ownerKind + "_" + item.id + ".json",outData);
         capLog("captured fire " + item.ownerKind + ":" + item.id + " 元件=" + names.length + " pngs=" + pngList.length);
      }

      private function capLabelsOf(mc:MovieClip) : Object
      {
         var out:Object = {};
         var labels:Array = mc.currentLabels;
         for(var i:int = 0; i < labels.length; i++)
         {
            out[String(labels[i].name)] = int(labels[i].frame);
         }
         return out;
      }

      // 递归扫描定位：枚举 mc 直接子对象，命中 wanted 记入 found；其余
      // 多帧 MovieClip 逐帧推进下钻（depth 层）。仅枚举不栅格化，成本低。
      // _capFoundCount 达到 wanted 总数即全树提前退出。
      private var _capFoundCount:int = 0;

      private function capSweepFind(mc:MovieClip, wanted:Object, found:Object, depth:int, id:String, r:int, wantedTotal:int) : void
      {
         if(depth <= 0 || mc.totalFrames < 1 || _capFoundCount >= wantedTotal)
         {
            return;
         }
         for(var f:int = 1; f <= mc.totalFrames; f++)
         {
            if(_capFoundCount >= wantedTotal)
            {
               return;
            }
            try
            {
               mc.gotoAndStop(f);
            }
            catch(le:Error)
            {
               capBootLog("fire locate " + id + " r" + r + " f" + f + " ERR: " + le.message);
            }
            for(var i:int = 0; i < mc.numChildren; i++)
            {
               var ch:MovieClip = mc.getChildAt(i) as MovieClip;
               if(ch == null || ch.name == null)
               {
                  continue;
               }
               if(found[ch.name] != null)
               {
                  continue;
               }
               if(wanted[ch.name] == true && ch.totalFrames >= 1)
               {
                  found[ch.name] = ch;
                  _capFoundCount++;
                  continue;
               }
               if(depth > 1 && ch.totalFrames > 1)
               {
                  capSweepFind(ch,wanted,found,depth - 1,id,r,wantedTotal);
               }
            }
         }
      }

      // ---------- 地图 capture：逐子图层 PNG + 偏移 ----------

      private function capMap(item:Object, content:*) : void
      {
         var spr:Sprite = content as Sprite;
         if(spr == null)
         {
            item.error = "地图 SWF root 不是 Sprite";
            return;
         }
         // 同 MapMain.initlize：移除 line_*/p1/p2 等标记节点
         var junk:Array = [];
         for(var i:int = 0; i < spr.numChildren; i++)
         {
            var c:DisplayObject = spr.getChildAt(i);
            var cn:String = c.name;
            if(cn == null)
            {
               continue;
            }
            if(cn.indexOf("line_") == 0 || cn == "p1" || cn == "p2")
            {
               junk.push(c);
            }
         }
         for each(var j:DisplayObject in junk)
         {
            spr.removeChild(j);
         }

         var layers:Array = [];
         var pngCount:int = 0;
         for(var k:int = 0; k < spr.numChildren; k++)
         {
            var ch:DisplayObject = spr.getChildAt(k);
            var b:Rectangle = ch.getBounds(ch);
            var bw:int = Math.ceil(b.width);
            var bh:int = Math.ceil(b.height);
            if(bw <= 0 || bh <= 0 || bw > 4096 || bh > 4096)
            {
               capBootLog("map layer skip " + item.id + " " + ch.name + " " + bw + "x" + bh);
               continue;
            }
            var bmp:BitmapData = new BitmapData(bw,bh,true,0);
            try
            {
               bmp.draw(ch,new Matrix(1,0,0,1,-b.x,-b.y),null,null,new Rectangle(0,0,bw,bh));
            }
            catch(e:Error)
            {
               capBootLog("map draw " + item.id + " " + ch.name + " ERR: " + e.message);
               bmp.dispose();
               continue;
            }
            var pngId:int = pngCount++;
            capWritePng("map_" + item.id,pngId,capPngEncode(bmp));
            bmp.dispose();
            layers.push({
               "name":ch.name,
               "png":pngId,
               "w":bw,
               "h":bh,
               "x":Math.round(ch.x * 100) / 100,
               "y":Math.round(ch.y * 100) / 100,
               "bx":Math.round(b.x * 100) / 100,
               "by":Math.round(b.y * 100) / 100
            });
         }
         var outData:Object = {
            "id":item.id,
            "fileUrl":item.url,
            "layers":layers
         };
         capWriteJson("atlas_map_" + item.id + ".json",outData);
         capLog("captured map " + item.id + " layers=" + layers.length);
      }

      // ---------- PNG 编码（最小实现：RGBA / filter 0 / zlib）----------

      private var _crcTable:Array;

      private function capCrcTable() : Array
      {
         if(_crcTable != null)
         {
            return _crcTable;
         }
         _crcTable = [];
         for(var n:uint = 0; n < 256; n++)
         {
            var c:uint = n;
            for(var k:int = 0; k < 8; k++)
            {
               if(c & 1)
               {
                  c = 3988292384 ^ (c >>> 1);
               }
               else
               {
                  c = c >>> 1;
               }
            }
            _crcTable[n] = c;
         }
         return _crcTable;
      }

      private function capCrc32(buf:ByteArray, start:int, len:int) : uint
      {
         var t:Array = capCrcTable();
         var c:uint = 4294967295;
         var end:int = start + len;
         for(var i:int = start; i < end; i++)
         {
            c = t[(c ^ buf[i]) & 255] ^ (c >>> 8);
         }
         return (c ^ 4294967295) & 4294967295;
      }

      private function capPngEncode(bmp:BitmapData) : ByteArray
      {
         var w:int = bmp.width;
         var h:int = bmp.height;
         // getPixels：ARGB 序（每像素 4 字节）→ 重排为 RGBA + 行首 filter 0
         var px:ByteArray = bmp.getPixels(new Rectangle(0,0,w,h));
         var raw:ByteArray = new ByteArray();
         var stride:int = w * 4;
         px.position = 0;
         for(var y:int = 0; y < h; y++)
         {
            raw.writeByte(0);
            for(var x4:int = 0; x4 < stride; x4 += 4)
            {
               var base:int = y * stride + x4;
               raw.writeByte(px[base + 1]);
               raw.writeByte(px[base + 2]);
               raw.writeByte(px[base + 3]);
               raw.writeByte(px[base]);
            }
         }
         px.length = 0;
         raw.compress();

         var out:ByteArray = new ByteArray();
         out.writeBytes(capPngSig());
         capChunk(out,"IHDR",capIhdr(w,h));
         capChunk(out,"IDAT",raw);
         capChunk(out,"IEND",new ByteArray());
         return out;
      }

      private function capPngSig() : ByteArray
      {
         var b:ByteArray = new ByteArray();
         b.writeByte(137);
         b.writeByte(80);
         b.writeByte(78);
         b.writeByte(71);
         b.writeByte(13);
         b.writeByte(10);
         b.writeByte(26);
         b.writeByte(10);
         return b;
      }

      private function capIhdr(w:int, h:int) : ByteArray
      {
         var b:ByteArray = new ByteArray();
         b.endian = Endian.BIG_ENDIAN;
         b.writeInt(w);
         b.writeInt(h);
         b.writeByte(8);
         b.writeByte(6);
         b.writeByte(0);
         b.writeByte(0);
         b.writeByte(0);
         return b;
      }

      private function capChunk(out:ByteArray, type:String, data:ByteArray) : void
      {
         var len:int = data.length;
         var body:ByteArray = new ByteArray();
         body.endian = Endian.BIG_ENDIAN;
         body.writeUTFBytes(type);
         body.writeBytes(data);
         out.endian = Endian.BIG_ENDIAN;
         out.writeInt(len);
         out.writeBytes(body);
         out.writeInt(capCrc32(body,0,body.length));
      }

      // ---------- 收尾 / IO ----------

      private function capWriteManifest() : void
      {
         // 过滤重采（capture-only.txt）时只覆盖本次采集的条目，其余沿用上次 manifest
         var prev:Object = {};
         try
         {
            var fm:File = File.documentsDirectory.resolvePath("bvn-atlas/manifest.json");
            if(fm.exists)
            {
               var sm:FileStream = new FileStream();
               sm.open(fm,"read");
               var mold:Object = JSON.parse(sm.readUTFBytes(sm.bytesAvailable));
               sm.close();
               for each(var mi:Object in mold.items)
               {
                  prev[mi.kind + ":" + mi.id] = mi;
               }
            }
         }
         catch(pe:Error)
         {
         }
         var cur:Object = {};
         var okCount:int = 0;
         var failCount:int = 0;
         var items:Array = [];
         for(var i:int = 0; i < _capItems.length; i++)
         {
            var it:Object = _capItems[i];
            if(it.ok)
            {
               okCount++;
            }
            if(it.error != null)
            {
               failCount++;
            }
            cur[it.kind + ":" + it.id] = true;
            items.push({"kind":it.kind,"id":it.id,"ok":it.ok == true,"error":it.error});
         }
         for(var key:String in prev)
         {
            if(cur[key] == null)
            {
               items.push(prev[key]);
            }
         }
         capWriteJson("manifest.json",{
            "finished":_capIdx >= _capItems.length,
            "done":_capIdx,
            "total":_capItems.length,
            "okCount":okCount,
            "failCount":failCount,
            "items":items,
            "log":_capLog
         });
      }

      private function capFinish() : void
      {
         capWriteManifest();
         capLog("ALL DONE");
         NativeApplication.nativeApplication.exit(0);
      }

      private function capWriteJson(param1:String, param2:*) : void
      {
         try
         {
            var f:File = File.documentsDirectory.resolvePath("bvn-atlas/" + param1);
            if(!f.parent.exists)
            {
               f.parent.createDirectory();
            }
            var s:FileStream = new FileStream();
            s.open(f,"write");
            s.writeUTFBytes(capJson(param2));
            s.close();
            capLog("written " + param1);
         }
         catch(e:Error)
         {
            capLog("FAIL write " + param1 + " :: " + e.message);
         }
      }

      private function capWritePng(param1:String, param2:int, param3:ByteArray) : void
      {
         try
         {
            var dir:File = File.documentsDirectory.resolvePath("bvn-atlas/png/" + param1);
            if(!dir.exists)
            {
               dir.createDirectory();
            }
            var f:File = dir.resolvePath(param2 + ".png");
            var s:FileStream = new FileStream();
            s.open(f,"write");
            s.writeBytes(param3);
            s.close();
         }
         catch(e:Error)
         {
            capLog("FAIL write png " + param1 + "/" + param2 + " :: " + e.message);
         }
      }

      // 最小 JSON 序列化器（同 dump 桥）
      private function capJson(param1:*) : String
      {
         if(param1 == null)
         {
            return "null";
         }
         if(param1 is String)
         {
            return "\"" + capEsc(param1 as String) + "\"";
         }
         if(param1 is Boolean)
         {
            return param1 ? "true" : "false";
         }
         if(param1 is int || param1 is uint)
         {
            return "" + param1;
         }
         if(param1 is Number)
         {
            var n:Number = param1;
            if(isNaN(n))
            {
               return "null";
            }
            if(!isFinite(n))
            {
               return n > 0 ? "1e308" : "-1e308";
            }
            return "" + n;
         }
         if(param1 is Array)
         {
            var a:Array = param1 as Array;
            var p1:Array = [];
            for(var i:int = 0; i < a.length; i++)
            {
               p1.push(capJson(a[i]));
            }
            return "[" + p1.join(",") + "]";
         }
         if(param1 is Class)
         {
            return "\"" + capEsc(String(param1)) + "\"";
         }
         var p2:Array = [];
         for(var k:String in param1)
         {
            var v:* = param1[k];
            if(v is Function)
            {
               continue;
            }
            p2.push("\"" + capEsc(k) + "\":" + capJson(v));
         }
         return "{" + p2.join(",") + "}";
      }

      private function capEsc(param1:String) : String
      {
         var s:String = param1;
         s = s.replace(/\\/g,"\\\\");
         s = s.replace(/\"/g,"\\\"");
         s = s.replace(/\r/g,"\\r");
         s = s.replace(/\n/g,"\\n");
         s = s.replace(/\t/g,"\\t");
         return s;
      }

