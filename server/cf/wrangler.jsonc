// BVN 房间服（游戏自有联机服务器）部署到 Cloudflare 的配置。
// 入口与 Durable Object 实现都在本目录；协议逻辑在 ../room-logic.mjs（与 Node 老服共用）。
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bvn-room",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomServer"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomServer" }
    ]
  },
  "routes": [
    { "pattern": "bvn.gamedock.cn", "custom_domain": true }
  ]
}
